<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="190dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/txtHolidayDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/_6_nights_7_days"
            android:textColor="#164E63"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtHolidayTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/holiday_package_01"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtHolidayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FEE2E2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/expired"
            android:textColor="#B91C1C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtExpiryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/holiday_expired_on_30_sep_2026"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
