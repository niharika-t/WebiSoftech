<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fragment_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivDetailBlogImage"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:background="@color/green_light"
            android:contentDescription="Blog cover image"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>


        <TextView
            android:id="@+id/tvDetailBlogDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="Travel and Lifestyle"
            android:textColor="#777777"
            android:textSize="13sp" />


        <TextView
            android:id="@+id/tvDetailBlogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="Blog Title"
            android:textColor="#173B2B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_marginLeft="20dp"
            android:layout_width="111dp"
            android:layout_height="3dp"
            android:layout_marginTop="16dp"
            android:background="@color/colorPrimary"/>

        <TextView
            android:id="@+id/tvDetailBlogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:text="Full blog description appears here."
            android:textColor="#444444"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />

    </LinearLayout>

</ScrollView>
