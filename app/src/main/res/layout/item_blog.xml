<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBlogImage"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:background="#E5E5E5"
            android:contentDescription="Blog image"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvBlogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explore Beautiful Destinations"
                android:textColor="#173B2B"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <View
                android:layout_width="66dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="@color/colorPrimary"/>

            <TextView
                android:id="@+id/tvBlogDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Discover amazing destinations and plan your next memorable holiday."
                android:textColor="#666666"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvBlogDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Travel and Lifestyle"
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
