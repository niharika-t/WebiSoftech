<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fragment_bg"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#F0ECF6">

            <ImageView
                android:id="@+id/ivResortDetailImage"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/green_light"
                android:contentDescription="Selected resort image"
                android:scaleType="centerCrop" />


        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR NEXT GETAWAY"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/tvResortDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Palm Shore Resort"
                android:textColor="#17151C"
                android:textSize="28sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="50dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="@color/colorPrimary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="About this resort"
                android:textColor="#211E27"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResortDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:lineSpacingExtra="7dp"
                android:text="Discover a relaxing stay with memorable experiences."
                android:textColor="#625D6B"
                android:textSize="16sp"
                android:includeFontPadding="true" />

            <TextView
                android:id="@+id/tvResortDetailLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#625D6B"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="#EEEAF3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Experience comfort. Create memories."
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="italic" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
