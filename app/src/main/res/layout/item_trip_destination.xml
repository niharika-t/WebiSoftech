<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:padding="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Destination Image -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="340dp">

            <ImageView
                android:id="@+id/ivTripImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/green_light"
                android:scaleType="centerCrop"
                android:contentDescription="Trip destination image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@color/colorPrimary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="✦ EXPLORE"
                android:textColor="#FFEA00"
                android:textSize="9sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <View
                android:layout_width="36dp"
                android:layout_height="2dp"
                android:background="#C5A15A" />

            <TextView
                android:id="@+id/tvTripTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#30283D"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvTripSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#9B7B3D"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvTripDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#77717F"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:maxLines="3" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
