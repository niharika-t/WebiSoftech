<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Member Profile"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAlignment="center"
            android:text="Manage your personal information"
            android:textColor="#697586"
            android:textSize="14sp" />

        <!-- Profile photo card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="#E8EDF5"
                android:clickable="true"
                android:contentDescription="Select profile photo"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tap to choose profile photo"
                android:textColor="#244A7C"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Personal information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Personal Information"
            android:textColor="#172B4D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- First name -->
        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="First Name"
            android:inputType="textPersonName|textCapWords"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Last name -->
        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Last Name"
            android:inputType="textPersonName|textCapWords"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Contact -->
        <EditText
            android:id="@+id/etContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Contact Number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Aadhaar -->
        <EditText
            android:id="@+id/etAadhaar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Aadhaar Number (12 digits)"
            android:inputType="number"
            android:maxLength="12"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Birth date -->
        <EditText
            android:id="@+id/etBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="Birth Date (select calendar)"
            android:padding="14dp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <!-- Age -->
        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Age (calculated automatically)"
            android:inputType="none"
            android:focusable="false"
            android:clickable="false"
            android:padding="14dp" />

        <!-- Gender dropdown -->
        <AutoCompleteTextView
            android:id="@+id/dropdownGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Select Gender"
            android:inputType="none"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Address information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="Address Information"
            android:textColor="#172B4D"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Country dropdown -->
        <AutoCompleteTextView
            android:id="@+id/dropdownCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Select Country"
            android:inputType="none"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- State dropdown -->
        <AutoCompleteTextView
            android:id="@+id/dropdownState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Select State"
            android:inputType="none"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- City dropdown -->
        <AutoCompleteTextView
            android:id="@+id/dropdownCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Select City"
            android:inputType="none"
            android:padding="14dp"
            android:singleLine="true" />

        <!-- Full address -->
        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="20dp"
            android:gravity="top|start"
            android:hint="Full Address"
            android:inputType="textPostalAddress|textMultiLine"
            android:padding="14dp" />

        <!-- Save profile button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#17365D"
            android:text="Save Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
