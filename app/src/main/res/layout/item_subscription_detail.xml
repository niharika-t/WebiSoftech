<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="5dp"
    app:cardUseCompatPadding="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#D8B65C" />

        <ImageView
            android:id="@+id/imgSubscriptionDetail"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@color/green_light"
            android:scaleType="centerCrop"
            android:contentDescription="Subscription detail image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXCLUSIVE EXPERIENCE"
                android:textColor="#A7832E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvSubscriptionDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Subscription Detail"
                android:textColor="#352449"
                android:textSize="21sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="#D8B65C" />

            <TextView
                android:id="@+id/tvSubscriptionDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Discover the information and benefits for this experience."
                android:textColor="#777181"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>